rules_version = '2';

// =====================================================================
// 회의실 예약 – Firestore 보안 규칙
// Firebase 콘솔 > Firestore Database > 규칙 탭에 전체를 붙여 넣고 [게시]하세요.
//
// ★ 관리자 이메일: 아래 목록을 실제 관리자 구글 계정으로 바꾸세요. (여러 명 가능)
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function adminEmails() {
      return ['lst624@tadstory.com'];
    }

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && ('email' in request.auth.token)
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.email in adminEmails();
    }
    function isStr(v, lo, hi) { return v is string && v.size() >= lo && v.size() <= hi; }
    function bookingPath(id) { return /databases/$(database)/documents/bookings/$(id); }

    // 회의실 목록·기본 설정: 누구나 보기, 관리자만 수정
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 예약: 누구나 보기. 생성은 익명 접속자 누구나(형식 검사), 취소는 본인 기기·비밀번호·관리자만
    match /bookings/{id} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['roomId','roomName','date','start','end','title','name','uid','status','slots','createdAt'])
        && request.resource.data.keys().hasAll(['roomId','date','start','end','title','name','uid','status','slots','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && isStr(request.resource.data.title, 1, 40)
        && isStr(request.resource.data.name, 1, 20)
        && isStr(request.resource.data.roomName, 0, 40)
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.start.matches('^[0-2][0-9]:[0-5][0-9]$')
        && request.resource.data.end.matches('^[0-2][0-9]:[0-5][0-9]$')
        && request.resource.data.start < request.resource.data.end
        && request.resource.data.slots is list
        && request.resource.data.slots.size() >= 1
        && request.resource.data.slots.size() <= 48
        && exists(/databases/$(database)/documents/rooms/$(request.resource.data.roomId))
        && existsAfter(/databases/$(database)/documents/secrets/$(id));

      // 취소 = 상태를 cancelled 로 바꾸는 것만 허용 (다른 내용 수정 불가)
      allow update: if resource.data.status == 'active'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelKey','cancelledAt'])
        && request.resource.data.cancelledAt == request.time
        && (
          isAdmin()
          || (signedIn() && resource.data.uid == request.auth.uid)
          || request.resource.data.cancelKey == get(/databases/$(database)/documents/secrets/$(id)).data.pinKey
        );

      allow delete: if isAdmin();
    }

    // 비공개 정보(이메일, 취소 비밀번호 해시): 관리자만 읽기
    match /secrets/{id} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['pinKey','email'])
        && request.resource.data.pinKey is string
        && request.resource.data.pinKey.matches('^[0-9a-f]{64}$')
        && isStr(request.resource.data.email, 3, 80)
        && getAfter(bookingPath(id)).data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // 30분 단위 시간 잠금: 같은 칸은 한 건만 존재 → 겹치는 예약을 서버에서 차단
    match /slots/{slotId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['bookingId'])
        && getAfter(bookingPath(request.resource.data.bookingId)).data.uid == request.auth.uid
        && getAfter(bookingPath(request.resource.data.bookingId)).data.status == 'active'
        && slotId in getAfter(bookingPath(request.resource.data.bookingId)).data.slots;
      allow update: if false;
      allow delete: if isAdmin()
        || getAfter(bookingPath(resource.data.bookingId)).data.status == 'cancelled';
    }
  }
}
